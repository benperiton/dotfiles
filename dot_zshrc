# Remove spacing on right side of prompt
export ZLE_RPROMPT_INDENT=0

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Powerlevel10k theme. POWERLEVEL9K_CONFIG_FILE keeps the generated config out
# of $HOME (p10k's default is ~/.p10k.zsh); `p10k configure` honours it, and the
# ~/.config/zsh/*.zsh loop below sources p10k.zsh after the theme is loaded.
export POWERLEVEL9K_CONFIG_FILE="$HOME/.config/zsh/p10k.zsh"
source "$HOME/.local/share/zsh/powerlevel10k/powerlevel10k.zsh-theme"

# ENVS
# TERM is intentionally not set here — the terminal emulator advertises it
# (alacritty/foot set their own + COLORTERM=truecolor); overriding it breaks
# truecolor and tmux/ssh TERM negotiation.
export HISTORY_IGNORE="(ls|cd|pwd|exit|sudo reboot|history|cd -|cd ..)"
export EDITOR="nvim"
export VISUAL="nvim"

export PATH="$PATH:$HOME/.local/bin"
# Only point at the agent socket if it actually exists, so a missing/down
# ssh-agent.service degrades gracefully instead of every ssh/git op failing
# against a dead socket path.
[[ -S "${XDG_RUNTIME_DIR}/ssh-agent.socket" ]] && export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"

# Source config files
for conf in "$HOME"/.config/zsh/*.zsh(N); do
    source "$conf"
done

# Plugins
source "$HOME/.local/share/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$HOME/.local/share/zsh/zsh-z/zsh-z.plugin.zsh"
source "$HOME/.local/share/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Direnv
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# Jujutsu (jj) completions
command -v jj &>/dev/null && source <(COMPLETE=zsh jj)
