#!/bin/sh
# Open files/dirs in Sublime Text, now installed natively via dnf (the official
# Sublime HQ repo). Usage: subl file.txt, subl dir, subl file:line:col
#
# This wrapper stays in place for one reason: FileZilla's "external editor".
# FileZilla runs in a Flatpak sandbox and can't exec a host binary directly, so
# it must break out to the host with flatpak-spawn (and it's configured to call
# this script by absolute path). On the host this is a thin passthrough to the
# real /usr/bin/subl, called by absolute path so the wrapper -- which shadows
# subl on PATH via ~/.local/bin -- never recurses into itself.
if [ -f /.flatpak-info ]; then
    # Inside a Flatpak sandbox (e.g. FileZilla's external editor): break out to
    # the host. Stay in the foreground so FileZilla can track the edit.
    exec flatpak-spawn --host subl "$@"
else
    # On the host: native subl returns immediately (it doesn't block unless
    # passed -w), so the terminal is freed without the old setsid detach.
    exec /usr/bin/subl "$@"
fi
