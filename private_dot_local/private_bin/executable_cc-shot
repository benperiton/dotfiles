#!/usr/bin/env bash
set -uo pipefail

# cc-shot — make a screenshot available to Claude Code running on devbox.
#
# Claude Code over SSH can't read a remote clipboard; it only ingests a local
# file path (it auto-detects a pasted path to an image and reads the file).
# This script region-captures with grim, lands the PNG on devbox at a fixed
# path, then copies that devbox-side path to the clipboard so you can paste it
# straight into Claude Code's prompt.
#
#   - From the laptop: the image is streamed to devbox over ssh.
#   - On devbox itself: the image is saved locally.
# Either way the clipboard ends up with the devbox path Claude Code needs.
#
# Bound to $mod+Print in sway. Leaves Print/Alt+Print/Ctrl+Print (grim+swappy)
# alone. Terminal- and tmux-agnostic: only a short text path is pasted.

box="devbox"
dir="/home/ben/.cache/cc-shots"
path="$dir/cc-$(date +%Y%m%d-%H%M%S).png"

# sway-launched processes don't inherit SSH_AUTH_SOCK like shells do, so point
# ssh at the systemd user ssh-agent (fixed socket, already holds the key).
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-${XDG_RUNTIME_DIR}/ssh-agent.socket}"

die() { notify-send -u critical "cc-shot failed" "$1" -t 8000; exit 1; }

# Region select on the local display; exit quietly if cancelled.
geom="$(slurp)" || exit 0

# Drop screenshots older than 7 days so the cache dir doesn't grow unbounded.
prune="find '$dir' -type f -name 'cc-*.png' -mtime +7 -delete"

if [ "$(hostname)" = "$box" ]; then
  mkdir -p "$dir"
  err="$(grim -g "$geom" "$path" 2>&1)" || die "grim: ${err:-unknown}"
  sh -c "$prune" 2>/dev/null || true
else
  # Non-interactive ssh: fail fast with a readable error instead of hanging.
  err="$({ grim -g "$geom" - \
    | ssh -o BatchMode=yes -o ConnectTimeout=8 "$box" \
        "mkdir -p '$dir' && cat > '$path' && $prune"; } 2>&1)" \
    || die "capture/ssh: ${err:-unknown}"
fi

printf '%s' "$path" | wl-copy || die "wl-copy failed"
notify-send "Claude Code screenshot" "Copied: $path" -t 2500
