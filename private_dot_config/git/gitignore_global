# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDEs
# No global .idea/ or .vscode/ — many repos intentionally commit those, and
# a global ignore silently prevents staging them everywhere. Let each repo's
# own .gitignore decide.
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Environment / secrets
.env
.env.*

# Dependencies
# No global vendor/ — Go/Composer projects that commit vendored deps need it
# tracked; this is a per-project decision.
node_modules/
__pycache__/
*.pyc

# Build output
dist/
build/
*.o
*.so

# Logs
*.log
npm-debug.log*

# Devbox
.devbox/
