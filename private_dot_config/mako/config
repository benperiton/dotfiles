font=FiraCode Nerd Font Mono 10
background-color=#282828
text-color=#ebdbb2
border-color=#d65d0e
border-size=3
border-radius=0
padding=8
margin=5
width=300
max-visible=5
default-timeout=10000
markup=1
format=<b>%s</b>\n%b
icon-path=/usr/share/icons/hicolor/16x16/apps:/usr/share/icons/Adwaita/16x16/status
max-icon-size=32
layer=overlay
anchor=top-right

[urgency=low]
background-color=#282828
text-color=#928374
default-timeout=10000

[urgency=normal]
background-color=#282828
text-color=#ebdbb2
default-timeout=20000

[urgency=critical]
background-color=#cc241d
text-color=#ebdbb2
border-color=#fb4934
default-timeout=0
