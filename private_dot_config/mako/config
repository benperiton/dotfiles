font=FiraCode Nerd Font Mono 10
background-color=#282a36
text-color=#f8f8f2
border-color=#6272a4
border-size=3
border-radius=0
padding=8
margin=5
width=300
max-visible=5
default-timeout=10000
markup=yes
format=<b>%s</b>\n%b
icon-path=/usr/share/icons/hicolor/16x16/apps:/usr/share/icons/Adwaita/16x16/status
max-icon-size=32
layer=overlay
anchor=top-right

[urgency=low]
background-color=#282a36
text-color=#6272a4
default-timeout=10000

[urgency=normal]
background-color=#282a36
text-color=#bd93f9
default-timeout=20000

[urgency=critical]
background-color=#ff5555
text-color=#f8f8f2
border-color=#ff5555
default-timeout=0
