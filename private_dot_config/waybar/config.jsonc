// -*- mode: jsonc -*-
[
    // ── Top bar ──────────────────────────────────────────────
    {
        "name": "top",
        "layer": "top",
        "position": "top",
        "height": 30,
        "spacing": 4,

        "modules-left": [
            "sway/workspaces",
            "sway/mode",
            "sway/scratchpad"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "pulseaudio",
            "backlight",
            "custom/dnd",
            "custom/power"
        ],

        "sway/workspaces": {
            // Per-output pinning matches the sway workspace assignments in
            // sway/config.d/40-outputs-work.conf.tmpl: workspaces 1-5 live on
            // the left office Dell, 6-10 on the right. eDP-1 is listed as a
            // fallback so the buttons still appear when undocked (single
            // laptop screen). Waybar 0.14 only matches output by short name
            // here, not by make+model+serial, so DP-6/DP-7 are used; if a
            // future reconnect shuffles the slot names the persistent
            // buttons will stop showing on the affected Dell (sway-side
            // workspace pinning is unaffected because that uses serial).
            // On other machines/monitors the DP-* names won't match and
            // only the eDP-1 entries take effect, which gives the previous
            // "all on the laptop" UX.
            "persistent-workspaces": {
                "1":  ["DP-6", "eDP-1"],
                "2":  ["DP-6", "eDP-1"],
                "3":  ["DP-6", "eDP-1"],
                "4":  ["DP-6", "eDP-1"],
                "5":  ["DP-6", "eDP-1"],
                "6":  ["DP-7", "eDP-1"],
                "7":  ["DP-7", "eDP-1"],
                "8":  ["DP-7", "eDP-1"],
                "9":  ["DP-7", "eDP-1"],
                "10": ["DP-7", "eDP-1"]
            }
        },
        "sway/mode": {
            "format": "<span style=\"italic\">{}</span>"
        },
        "sway/scratchpad": {
            "format": "{icon} {count}",
            "show-empty": false,
            "format-icons": ["", ""],
            "tooltip": true,
            "tooltip-format": "{app}: {title}"
        },
        "clock": {
            "format": "{:%a %b %d  %H:%M}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "format-alt": "{:%Y-%m-%d  %H:%M:%S}"
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-bluetooth": "󰂯 {volume}%",
            "format-muted": "󰝟 muted",
            "format-icons": {
                "headphone": "󰋋",
                "default": ["󰕿", "󰖀", "󰕾"]
            },
            "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
            "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
            "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
            "tooltip-format": "{desc} — {volume}%"
        },
        "backlight": {
            "format": "{icon} {percent}%",
            "format-icons": ["󰃞", "󰃟", "󰃠"],
            "on-scroll-up": "brightnessctl set 2%+",
            "on-scroll-down": "brightnessctl set 2%-"
        },
        "custom/dnd": {
            "format": "{}",
            "exec": "if makoctl mode | grep -q do-not-disturb; then echo ''; else echo ''; fi",
            "on-click": "if makoctl mode | grep -q do-not-disturb; then makoctl mode -r do-not-disturb; else makoctl mode -a do-not-disturb; fi; pkill -RTMIN+1 waybar",
            "signal": 1,
            "interval": "once",
            "tooltip-format": "Toggle Do Not Disturb"
        },
        "custom/power": {
            "format": "⏻",
            "tooltip": false,
            "on-click": "wlogout"
        }
    },

    // ── Bottom bar ───────────────────────────────────────────
    {
        "name": "bottom",
        "layer": "top",
        "position": "bottom",
        "height": 30,
        "spacing": 4,

        "modules-left": [
            "custom/vpn"
        ],
        "modules-center": [],
        "modules-right": [
            "tray",
            "battery",
            "power-profiles-daemon"
        ],

        "tray": {
            "spacing": 10
        },
        "custom/vpn": {
            "format": "{}",
            "return-type": "json",
            "exec": "~/.config/waybar/vpn-status.sh",
            "interval": 5,
            "signal": 8,
            "on-click": "~/.config/waybar/warp-toggle.sh"
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon} {capacity}% ({time})",
            "format-full": "{icon} Full",
            "format-charging": " {capacity}% ({time})",
            "format-plugged": " {capacity}%",
            "format-icons": ["", "", "", "", ""]
        },
        "power-profiles-daemon": {
            "format": "{icon}",
            "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
            "tooltip": true,
            "format-icons": {
                "default": "",
                "performance": "",
                "balanced": "",
                "power-saver": ""
            }
        }
    }
]
