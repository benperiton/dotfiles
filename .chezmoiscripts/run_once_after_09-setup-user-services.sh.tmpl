#!/bin/bash
set -euo pipefail

echo "Enabling user services..."

systemctl --user daemon-reload

for svc in ssh-agent.service tmux.service; do
    if ! systemctl --user is-enabled "$svc" &>/dev/null; then
        echo "Enabling $svc"
        systemctl --user enable --now "$svc"
    fi
done
{{- if eq .machine_role "work" }}

# Cloudflare WARP tray suppression (work only). The rpm's %post enables and
# starts the warp-desktop-svc *user* unit for every regular user -- that unit
# drives the GTK/appindicator tray and the SSO webview behind the bogus
# webkit2gtk3 dep. We don't want the tray: WARP status lives in waybar
# (custom/vpn via vpn-status.sh). Stop + mask the unit; masking is a /dev/null
# symlink that also survives rpm upgrades (which re-run that %post and would
# otherwise re-enable it). Guarded on rpm -q so an absent/failed install can't
# abort this script. warp-svc (the system daemon) is enabled by script 01 and
# is intentionally left running.
if rpm -q cloudflare-warp &>/dev/null; then
    systemctl --user stop warp-desktop-svc.service 2>/dev/null || true
    if [ "$(systemctl --user is-enabled warp-desktop-svc.service 2>/dev/null)" != "masked" ]; then
        echo "Masking warp-desktop-svc (WARP tray); status is in waybar"
        systemctl --user mask warp-desktop-svc.service
    fi
fi
{{- end }}

echo "User services configured"
