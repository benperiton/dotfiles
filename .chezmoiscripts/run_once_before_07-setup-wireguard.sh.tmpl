#!/usr/bin/env bash
set -Eeuo pipefail
{{- if and (eq .machine_role "personal") (eq .machine_type "laptop") }}

trap 'echo "Error on line $LINENO: $BASH_COMMAND" >&2; exit 1' ERR

need_cmd() { command -v "$1" >/dev/null 2>&1; }
nm_has_conn() { nmcli -t -f NAME connection show | grep -Fxq "$1"; }

if ! need_cmd wg; then
  echo "WireGuard not installed (need 'wg')." >&2
  exit 1
fi

CONF_DIR="/etc/wireguard"

BASE_NAME="wg-{{ onepasswordRead (printf "op://%s/dotfiles-vpn/wg-home.name" .df_vault) }}"

WG_SERVER_ENDPOINT={{ onepasswordRead (printf "op://%s/dotfiles-vpn/wg-home.server-endpoint" .df_vault) | quote }}
WG_SERVER_PUBLICKEY={{ onepasswordRead (printf "op://%s/dotfiles-vpn/wg-home.server-publickey" .df_vault) | quote }}
WG_CLIENT_DNS={{ onepasswordRead (printf "op://%s/dotfiles-vpn/wg-home.client-dns" .df_vault) | quote }}
WG_CLIENT_PRIVATEKEY={{ onepasswordRead (printf "op://%s/dotfiles-vpn/wg-home.client-privatekey" .df_vault) | quote }}
WG_CLIENT_ADDRESS={{ onepasswordRead (printf "op://%s/dotfiles-vpn/wg-home.client-address" .df_vault) | quote }}
WG_CLIENT_ALLOWED_IPS={{ onepasswordRead (printf "op://%s/dotfiles-vpn/wg-home.client-allowedips" .df_vault) | quote }}
WG_CLIENT_PRESHAREDKEY={{ onepasswordRead (printf "op://%s/dotfiles-vpn/wg-home.client-presharedkey" .df_vault) | quote }}

sudo -v
sudo install -d -m 700 "$CONF_DIR"

tmp="$(mktemp)"
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT

# Build the desired conf, then compare. Returns 0 if it wrote/changed the
# file, 1 if it was already up to date. This is a .tmpl, so a rotated key in
# 1Password changes the rendered script and run_once re-runs it; the old
# "skip if exists" guard meant rotations never reached /etc/wireguard.
write_conf() {
  local name="$1"
  local allowed_ips="$2"
  local conf_path="${CONF_DIR}/${name}.conf"

  cat > "$tmp" <<EOF
[Interface]
PrivateKey = ${WG_CLIENT_PRIVATEKEY}
Address = ${WG_CLIENT_ADDRESS}
DNS = ${WG_CLIENT_DNS}

[Peer]
PublicKey = ${WG_SERVER_PUBLICKEY}
EOF

  if [ -n "${WG_CLIENT_PRESHAREDKEY}" ]; then
    cat >> "$tmp" <<EOF
PresharedKey = ${WG_CLIENT_PRESHAREDKEY}
EOF
  fi

  cat >> "$tmp" <<EOF
AllowedIPs = ${allowed_ips}
Endpoint = ${WG_SERVER_ENDPOINT}
PersistentKeepalive = 25
EOF

  if sudo test -f "$conf_path" && sudo cmp -s "$tmp" "$conf_path"; then
    echo "${conf_path} unchanged"
    return 1
  fi

  sudo install -m 600 "$tmp" "$conf_path"
  echo "Wrote ${conf_path}"
  return 0
}

import_nm() {
  local name="$1"
  local changed="${2:-0}"
  local conf_path="${CONF_DIR}/${name}.conf"

  if ! need_cmd nmcli; then
    echo "nmcli not found; skipping NetworkManager import for '$name'"
    return 0
  fi

  if nm_has_conn "$name"; then
    if [ "$changed" != "1" ]; then
      echo "NetworkManager connection '$name' already exists"
      return 0
    fi
    echo "Re-importing changed '$name' into NetworkManager"
    sudo nmcli connection delete "$name" >/dev/null 2>&1 || true
  fi

  sudo nmcli connection import type wireguard file "$conf_path"
  sudo nmcli connection modify "$name" connection.autoconnect no
  sudo nmcli connection down "$name" >/dev/null 2>&1 || true
  echo "Imported '$name' into NetworkManager (autoconnect disabled)"
}

# write_conf returns non-zero when the conf is already up to date; under
# `set -e` it must be used as a condition, which also tells import_nm
# whether to re-import a changed profile.
# Split tunnel
if write_conf "$BASE_NAME" "$WG_CLIENT_ALLOWED_IPS"; then
  import_nm "$BASE_NAME" 1
else
  import_nm "$BASE_NAME" 0
fi

# Full tunnel
if write_conf "${BASE_NAME}-all" "0.0.0.0/0, ::/0"; then
  import_nm "${BASE_NAME}-all" 1
else
  import_nm "${BASE_NAME}-all" 0
fi

echo ""
echo "VPN profiles:"
echo "  - Split tunnel: ${BASE_NAME}"
echo "  - Full tunnel : ${BASE_NAME}-all"
echo "  (Only bring up one at a time.)"
{{- end }}
