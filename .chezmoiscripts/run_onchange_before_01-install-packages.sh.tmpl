#!/bin/bash
set -euo pipefail

# Base packages for all machines (including headless)
BASE_PACKAGES=(
    zsh
    git
    tmux
    wireguard-tools
    mosh
    ripgrep
    bat
    btop
    lsd
    tealdeer
    lazygit
    direnv
    prettyping
    neovim
    cabextract
    ImageMagick
    rsvg-convert
    qrencode
)

{{- if ne .machine_type "headless" }}
# GUI packages (desktop/laptop only)
GUI_PACKAGES=(
    sway
    alacritty
    NetworkManager
    # NetworkManager is only the daemon; nm-applet is a separate package and is
    # the sole GUI for joining a network here, since waybar has no network
    # module. It needs no sway exec: the package ships
    # /etc/xdg/autostart/nm-applet.desktop, which systemd's XDG autostart
    # generator turns into app-nm\x2dapplet@autostart.service. Script 06
    # provisions the home SSID from 1Password, so a rebuild gets online
    # unattended at home; this is what covers every other network.
    network-manager-applet
    flatpak
    autorandr
    gammastep
    mako
    wlogout
    swappy
    # blueman provides blueman-applet, started from the sway config's exec
    # block; its tray icon is how devices get paired and connected on these
    # machines. Not a weak dep of anything we install, and script 01 runs dnf
    # with install_weak_deps=False, so it has to be listed explicitly or the
    # sway exec silently points at a missing binary. (The AirPods-specific
    # controller/codec setup lives in script 10.)
    blueman
    ffmpeg
    gstreamer1-plugins-bad-freeworld
    gstreamer1-plugins-ugly
    gstreamer1-vaapi
    # poppler-utils provides pdftoppm, used by the pptx-editing skill's render.sh
    # to turn rendered slide PDFs into per-slide PNGs for visual verification.
    # (python-pptx is in its own venv; LibreOffice is a flatpak in script 08.)
    poppler-utils
    # Browsers, VS Code and Sublime Text: installed via dnf (Microsoft / Google
    # / Sublime HQ repos configured below), NOT as Flatpaks. Flatpak builds are
    # sandboxed and break host integration. Editors (VS Code, Sublime) lose the
    # integrated terminal, host toolchains / Docker, language servers and many
    # extensions; browsers lose native messaging and host file access. The
    # Sublime Flathub package (com.sublimetext.three) is also unmaintained, stuck
    # on ST3 3.2.2, so the dnf repo gives a current ST4 with real dnf updates.
    # firefox is role-agnostic (all GUI machines); google-chrome-stable is
    # personal-only; microsoft-edge-stable is work-only (Chromium-based, so it
    # replaces Chrome on work). The matching Flatpaks are removed in
    # run_onchange_before_08-setup-gui-apps.sh.tmpl.
    code
    sublime-text
    firefox
{{- if eq .machine_role "personal" }}
    google-chrome-stable
{{- else if eq .machine_role "work" }}
    microsoft-edge-stable
{{- end }}
)
{{- end }}

{{- if ne .machine_type "headless" }}
# RPM Fusion repos (needed for multimedia codecs)
if ! dnf repolist | grep -q rpmfusion-free; then
    sudo dnf install -y \
        "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"
fi

# Swap ffmpeg-free for full ffmpeg (RPM Fusion) if not already done
if rpm -q ffmpeg-free &>/dev/null; then
    sudo dnf swap ffmpeg-free ffmpeg --allowerasing -y
fi

# VS Code repo
if ! dnf repolist | grep -q code; then
    sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
    echo -e "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc" | sudo tee /etc/yum.repos.d/vscode.repo > /dev/null
fi

# Sublime Text repo (official Sublime HQ; current ST4 with dnf updates, unlike
# the unmaintained com.sublimetext.three Flathub build removed in script 08).
if ! dnf repolist | grep -q sublime-text; then
    sudo rpm --import https://download.sublimetext.com/sublimehq-pub.gpg
    sudo dnf config-manager addrepo --from-repofile=https://download.sublimetext.com/rpm/stable/x86_64/sublime-text.repo
fi
{{- if eq .machine_role "personal" }}

# Google Chrome repo (personal machines only)
if ! dnf repolist | grep -q google-chrome; then
    sudo rpm --import https://dl.google.com/linux/linux_signing_key.pub
    echo -e "[google-chrome]\nname=google-chrome\nbaseurl=https://dl.google.com/linux/chrome/rpm/stable/x86_64\nenabled=1\ngpgcheck=1\ngpgkey=https://dl.google.com/linux/linux_signing_key.pub" | sudo tee /etc/yum.repos.d/google-chrome.repo > /dev/null
fi
{{- else if eq .machine_role "work" }}

# Microsoft Edge repo (work machines only)
if ! dnf repolist | grep -q microsoft-edge; then
    sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
    echo -e "[microsoft-edge]\nname=microsoft-edge\nbaseurl=https://packages.microsoft.com/yumrepos/edge\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc" | sudo tee /etc/yum.repos.d/microsoft-edge.repo > /dev/null
fi
{{- end }}
{{- end }}

# Docker repo (needed for docker-ce packages)
if ! dnf repolist | grep -q docker-ce; then
    sudo dnf config-manager addrepo --from-repofile https://download.docker.com/linux/fedora/docker-ce.repo
fi

# lazygit is not in the Fedora repos; enable the upstream-recommended COPR
# (https://github.com/jesseduffield/lazygit#installation). Assumes the dnf
# copr plugin is present, the same assumption the config-manager calls make.
if ! dnf repolist | grep -q 'dejan:lazygit'; then
    sudo dnf copr enable -y dejan/lazygit
fi

DOCKER_PACKAGES=(
    docker-ce
    docker-ce-cli
    containerd.io
    docker-buildx-plugin
    docker-compose-plugin
)

# Role-specific packages
{{- if eq .machine_role "personal" }}
ROLE_PACKAGES=(
    # Add personal-machine packages here
)
{{- else if eq .machine_role "work" }}
ROLE_PACKAGES=(
    # Add work-machine packages here
)
{{- end }}

ALL_PACKAGES=("${BASE_PACKAGES[@]}" "${DOCKER_PACKAGES[@]}" "${ROLE_PACKAGES[@]}")
{{- if ne .machine_type "headless" }}
ALL_PACKAGES+=("${GUI_PACKAGES[@]}")
{{- end }}

# Install any that are missing
MISSING=()
for pkg in "${ALL_PACKAGES[@]}"; do
    if ! rpm -q "$pkg" &>/dev/null; then
        MISSING+=("$pkg")
    fi
done

if [ ${#MISSING[@]} -gt 0 ]; then
    echo "Installing: ${MISSING[*]}"
    sudo dnf install -y --setopt=install_weak_deps=False "${MISSING[@]}"
fi

# Optional tools fetched from the internet. A failure here (e.g. a restricted
# corporate network that blocks/inspects GitHub release downloads) must NOT
# abort provisioning — warn and continue so the rest of the machine is still
# set up. Each block runs in a subshell with its own errexit so a mid-block
# failure stops that tool only.

# Install Claude Code
if ! command -v claude &>/dev/null; then
    echo "Installing Claude Code..."
    if ! ( set -eo pipefail; curl -fsSL https://claude.ai/install.sh | bash ); then
        echo "WARNING: Claude Code install failed — skipping" >&2
    fi
fi

# Install Devbox
if ! command -v devbox &>/dev/null; then
    echo "Installing Devbox..."
    if ! ( set -eo pipefail; curl -fsSL https://get.jetify.com/devbox | bash ); then
        echo "WARNING: Devbox install failed — skipping" >&2
    fi
fi

# Install Jujutsu (jj) — to ~/.local/bin, no sudo
if ! command -v jj &>/dev/null; then
    echo "Installing Jujutsu..."
    if ! (
        set -eo pipefail
        # Parse the tag from the full response (no `curl | grep -m1`: grep
        # closes the pipe early, curl gets a write error, and pipefail then
        # aborts the install spuriously).
        re='"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)"'
        jj_api=$(curl -fsSL https://api.github.com/repos/jj-vcs/jj/releases/latest)
        [[ $jj_api =~ $re ]] || { echo "could not determine jj version" >&2; exit 1; }
        JJ_VERSION=${BASH_REMATCH[1]}
        mkdir -p ~/.local/bin
        tmp=$(mktemp)
        trap 'rm -f "$tmp"' EXIT
        curl -fsSL "https://github.com/jj-vcs/jj/releases/download/${JJ_VERSION}/jj-${JJ_VERSION}-x86_64-unknown-linux-musl.tar.gz" -o "$tmp"
        gzip -t "$tmp"
        tar xz --strip-components=1 -C ~/.local/bin -f "$tmp" ./jj
    ); then
        echo "WARNING: jj install failed (network/download blocked?) — skipping" >&2
    fi
fi
{{- if ne .machine_type "headless" }}

# Zed editor (GUI machines only). No official rpm repo, so use Zed's official
# installer, which drops a self-updating build under ~/.local (no sudo) and a
# launcher + desktop entry. Native rather than Flatpak for the same reason as
# VS Code / Sublime: an editor needs host toolchains, the integrated terminal
# and language servers, which the sandbox breaks. warn-and-continue.
if ! command -v zed &>/dev/null; then
    echo "Installing Zed..."
    if ! ( set -eo pipefail; curl -fsSL https://zed.dev/install.sh | sh ); then
        echo "WARNING: Zed install failed (network blocked?) — skipping" >&2
    fi
fi
{{- end }}
{{- if eq .machine_role "work" }}

# Cloudflare WARP (Zero Trust client). Fedora is community-supported, not
# officially supported by Cloudflare. The latest rpm hard-Requires webkit2gtk3,
# which Fedora 43 removed (it ships webkit2gtk4.1 / webkitgtk6.0), so installing
# the latest is unsatisfiable. We instead pin a vetted older build whose Requires
# are only ca-certificates, dbus, desktop-file-utils, glibc, iproute, libpcap,
# nftables and nss-tools -- all in Fedora's stock repos -- so it installs cleanly
# with normal dependency resolution (no --nodeps).
#
# The pinned artifact is fetched directly from downloads.cloudflareclient.com and
# is NOT GPG-signed (rpm -Kv shows digests only; all signature headers are none),
# so we verify it against a pinned SHA256 instead of a signature. No signed copy
# of this clean version exists (the signed repo serves only the broken latest),
# so this is the integrity ceiling. We deliberately do NOT add the cloudflare-warp
# yum repo: an enabled repo would make `dnf upgrade` try (and fail) to pull the
# webkit2gtk3-requiring latest. To bump WARP, change WARP_PIN + WARP_SHA256 below;
# this is a run_onchange script so editing them re-runs this block.
#
# Enrollment stays manual via SSO (warp-cli teams-enroll <team>; warp-cli
# connect), intentionally not scripted, so no org name or secret lives in the
# repo. The GUI tray (warp-desktop-svc user unit) is masked by the
# run_after_20-warp-tray-mask script; WARP status lives in waybar (custom/vpn).
WARP_PIN="2026.3.846.0"
WARP_SHA256="a272001189ffdfe6886b5520d396d17c99065fb66f9aaf3a48e36ca6e0fa6358"
WARP_URL="https://downloads.cloudflareclient.com/v1/download/fedora34-intel/version/${WARP_PIN}"

# Remove the repo left by the previous --nodeps approach so dnf upgrade can't try
# the broken latest. No-op once gone.
if [ -f /etc/yum.repos.d/cloudflare-warp.repo ]; then
    sudo rm -f /etc/yum.repos.d/cloudflare-warp.repo
fi

if [ "$(rpm -q --qf '%{VERSION}' cloudflare-warp 2>/dev/null || true)" != "$WARP_PIN" ]; then
    echo "Installing Cloudflare WARP ${WARP_PIN} (pinned, clean deps)..."
    if ! (
        set -eo pipefail
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        curl -fSL --max-time 120 -o "$tmp/warp.rpm" "$WARP_URL"
        echo "${WARP_SHA256}  $tmp/warp.rpm" | sha256sum -c -
        sudo dnf install -y --setopt=localpkg_gpgcheck=0 "$tmp/warp.rpm"
        sudo systemctl enable --now warp-svc.service
    ); then
        echo "WARNING: cloudflare-warp install failed (network, checksum, or packaging change?); skipping" >&2
    fi
fi
{{- end }}
