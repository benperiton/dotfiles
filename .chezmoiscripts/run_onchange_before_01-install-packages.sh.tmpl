#!/bin/bash
set -euo pipefail

# Base packages for all machines (including headless)
BASE_PACKAGES=(
    zsh
    git
    tmux
    wireguard-tools
    mosh
    ripgrep
    bat
    btop
    lsd
    direnv
    prettyping
    neovim
    nix
)

{{- if ne .machine_type "headless" }}
# GUI packages (desktop/laptop only)
GUI_PACKAGES=(
    sway
    alacritty
    NetworkManager
    flatpak
    autorandr
    gammastep
    mako
    wlogout
    swappy
    ffmpeg
    gstreamer1-plugins-bad-freeworld
    gstreamer1-plugins-ugly
    gstreamer1-vaapi
    code
)
{{- end }}

{{- if ne .machine_type "headless" }}
# RPM Fusion repos (needed for multimedia codecs)
if ! dnf repolist | grep -q rpmfusion-free; then
    sudo dnf install -y \
        "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"
fi

# Swap ffmpeg-free for full ffmpeg (RPM Fusion) if not already done
if rpm -q ffmpeg-free &>/dev/null; then
    sudo dnf swap ffmpeg-free ffmpeg --allowerasing -y
fi

# VS Code repo
if ! dnf repolist | grep -q code; then
    sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
    echo -e "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc" | sudo tee /etc/yum.repos.d/vscode.repo > /dev/null
fi
{{- end }}

# Docker repo (needed for docker-ce packages)
if ! dnf repolist | grep -q docker-ce; then
    sudo dnf config-manager addrepo --from-repofile https://download.docker.com/linux/fedora/docker-ce.repo
fi

DOCKER_PACKAGES=(
    docker-ce
    docker-ce-cli
    containerd.io
    docker-buildx-plugin
    docker-compose-plugin
)

# Role-specific packages
{{- if eq .machine_role "personal" }}
ROLE_PACKAGES=(
    # Add personal-machine packages here
)
{{- else if eq .machine_role "work" }}
ROLE_PACKAGES=(
    # Add work-machine packages here
)
{{- end }}

ALL_PACKAGES=("${BASE_PACKAGES[@]}" "${DOCKER_PACKAGES[@]}" "${ROLE_PACKAGES[@]}")
{{- if ne .machine_type "headless" }}
ALL_PACKAGES+=("${GUI_PACKAGES[@]}")
{{- end }}

# Install any that are missing
MISSING=()
for pkg in "${ALL_PACKAGES[@]}"; do
    if ! rpm -q "$pkg" &>/dev/null; then
        MISSING+=("$pkg")
    fi
done

if [ ${#MISSING[@]} -gt 0 ]; then
    echo "Installing: ${MISSING[*]}"
    sudo dnf install -y --setopt=install_weak_deps=False "${MISSING[@]}"
fi

# Install Claude Code
if ! command -v claude &>/dev/null; then
    echo "Installing Claude Code..."
    curl -fsSL https://claude.ai/install.sh | bash
fi

# Install Devbox
if ! command -v devbox &>/dev/null; then
    echo "Installing Devbox..."
    curl -fsSL https://get.jetify.com/devbox | bash
fi

# Install Jujutsu (jj)
if ! command -v jj &>/dev/null; then
    echo "Installing Jujutsu..."
    JJ_VERSION=$(curl -fsSL https://api.github.com/repos/jj-vcs/jj/releases/latest | grep -m1 '"tag_name"' | cut -d'"' -f4)
    mkdir -p ~/.local/bin
    curl -fsSL "https://github.com/jj-vcs/jj/releases/download/${JJ_VERSION}/jj-${JJ_VERSION}-x86_64-unknown-linux-musl.tar.gz" | tar xz --strip-components=1 -C ~/.local/bin ./jj
fi