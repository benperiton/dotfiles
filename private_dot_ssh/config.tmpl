# -- General --
# Auto-add keys to agent on first use
AddKeysToAgent yes

# -- Git --
# Both stanzas are emitted on every machine so SSH "just works" for
# whichever key is dropped in; an entry whose key file is absent is
# harmless (ssh only uses it when you actually connect to that host).

Host github.com
    HostName github.com
    IdentityFile ~/.ssh/id_github
    User git
    IdentitiesOnly yes

Host gitlab.com
    HostName gitlab.com
    IdentityFile ~/.ssh/id_gitlab
    User git
    IdentitiesOnly yes
{{- if eq .machine_role "personal" }}

# -- Home --

{{ onepasswordRead "op://ben-dotfiles/dotfiles-ssh/config.home" }}
{{- end }}

# -- Servers --

{{ onepasswordRead (printf "op://%s/dotfiles-ssh/config.servers" .df_vault) }}
